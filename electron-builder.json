{
  "appId": "io.expertmesh.desktop",
  "productName": "ExpertMesh",
  "electronDist": "node_modules/electron/dist",
  "directories": { "app": "desktop-build/app", "output": "release" },
  "files": ["*.cjs", "package.json", "dist/**/*", "!node_modules/**/*"],
  "asar": true,
  "npmRebuild": false,
  "win": { "target": ["nsis"] },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
  "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
  "linux": { "target": ["AppImage"], "category": "Office" },
  "publish": null
}
